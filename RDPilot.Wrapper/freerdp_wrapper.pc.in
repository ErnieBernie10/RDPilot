prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: freerdp_wrapper
Description: Wrapper library for FreeRDP
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lfreerdp_wrapper
Cflags: -I${includedir}
Requires.private: freerdp3 freerdp-client3 winpr3
