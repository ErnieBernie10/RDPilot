<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <NativeWrapperProjectDir>$(MSBuildProjectDirectory)/../RDPilot.Wrapper</NativeWrapperProjectDir>
        <NativeWrapperCMakeArgs></NativeWrapperCMakeArgs>
        <NativeWrapperVcpkgRoot Condition="'$(NativeWrapperVcpkgRoot)' == '' and Exists('$(MSBuildProjectDirectory)/../../vcpkg/scripts/buildsystems/vcpkg.cmake')">$(MSBuildProjectDirectory)/../../vcpkg</NativeWrapperVcpkgRoot>
        <NativeWrapperVcpkgRoot Condition="'$(NativeWrapperVcpkgRoot)' == '' and Exists('C:/vcpkg/scripts/buildsystems/vcpkg.cmake')">C:/vcpkg</NativeWrapperVcpkgRoot>
        <NativeWrapperVcpkgTriplet Condition="'$(NativeWrapperVcpkgTriplet)' == '' and '$(RuntimeIdentifier)' == 'win-x64'">x64-windows</NativeWrapperVcpkgTriplet>
        <NativeWrapperVcpkgTriplet Condition="'$(NativeWrapperVcpkgTriplet)' == ''">x64-windows</NativeWrapperVcpkgTriplet>
        <NativeWrapperVcpkgManifestDir Condition="'$(NativeWrapperVcpkgManifestDir)' == ''">$(MSBuildProjectDirectory)/..</NativeWrapperVcpkgManifestDir>
        <NativeWrapperVcpkgInstalledDir Condition="'$(NativeWrapperVcpkgInstalledDir)' == ''">$(NativeWrapperVcpkgManifestDir)/vcpkg_installed</NativeWrapperVcpkgInstalledDir>
        <NativeWrapperVcpkgOverlayPorts Condition="'$(NativeWrapperVcpkgOverlayPorts)' == ''">$(NativeWrapperVcpkgManifestDir)/vcpkg-overlay-ports</NativeWrapperVcpkgOverlayPorts>
        <NativeWrapperUseVcpkg Condition="'$(NativeWrapperUseVcpkg)' == '' and '$(NativeWrapperVcpkgRoot)' != ''">true</NativeWrapperUseVcpkg>
        <NativeWrapperUseVcpkg Condition="'$(NativeWrapperUseVcpkg)' == ''">false</NativeWrapperUseVcpkg>
        <NativeWrapperCMakeArgs Condition="'$(NativeWrapperUseVcpkg)' == 'true' and '$(NativeWrapperCMakeArgs)' == ''">-DCMAKE_TOOLCHAIN_FILE=$(NativeWrapperVcpkgRoot)/scripts/buildsystems/vcpkg.cmake -DVCPKG_MANIFEST_DIR=$(NativeWrapperVcpkgManifestDir) -DVCPKG_INSTALLED_DIR=$(NativeWrapperVcpkgInstalledDir) -DVCPKG_OVERLAY_PORTS=$(NativeWrapperVcpkgOverlayPorts)</NativeWrapperCMakeArgs>
        <NativeWrapperBuildFlavor Condition="'$(NativeWrapperBuildFlavor)' == '' and '$(NativeWrapperUseVcpkg)' == 'true'">vcpkg-msvc</NativeWrapperBuildFlavor>
        <NativeWrapperBuildFlavor Condition="'$(NativeWrapperBuildFlavor)' == ''">native</NativeWrapperBuildFlavor>
        <NativeWrapperBuildDir>$(NativeWrapperProjectDir)/build/$(NativeWrapperBuildFlavor)</NativeWrapperBuildDir>
        <NativeWrapperCMakeExe Condition="'$(NativeWrapperCMakeExe)' == ''">cmake</NativeWrapperCMakeExe>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
        <None Include="connection.local.json" Condition="Exists('connection.local.json')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>RDPilot.Client.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <Target Name="BuildNativeWrapper" BeforeTargets="BeforeBuild">
        <Message Importance="High" Text="Building Native Wrapper..." />
        <MakeDir Directories="$(NativeWrapperBuildDir)" />
        <Exec Command="&quot;$(NativeWrapperCMakeExe)&quot; --no-warn-unused-cli -S &quot;$(NativeWrapperProjectDir)&quot; -B &quot;$(NativeWrapperBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration) $(NativeWrapperCMakeArgs)" />
        <Exec Command="&quot;$(NativeWrapperCMakeExe)&quot; --build &quot;$(NativeWrapperBuildDir)&quot; --config $(Configuration)" />

        <ItemGroup>
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.so" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.so')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/freerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/freerdp_wrapper.dll')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/$(Configuration)/*.dll" Condition="Exists('$(NativeWrapperBuildDir)/$(Configuration)/freerdp_wrapper.dll')" />
        </ItemGroup>
        <Error Condition="'@(NativeLib)' == ''" Text="Native wrapper build succeeded, but no freerdp_wrapper native library was found in $(NativeWrapperBuildDir)." />
        <Copy SourceFiles="@(NativeLib)"
              DestinationFolder="$(OutputPath)"
              ContinueOnError="false" />
    </Target>
    <Target Name="CopyNativeWrapperToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
        <ItemGroup>
            <NativePublishLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.so" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.so')" />
            <NativePublishLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib')" />
            <NativePublishLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll')" />
            <NativePublishLib Include="$(NativeWrapperBuildDir)/freerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/freerdp_wrapper.dll')" />
            <NativePublishLib Include="$(NativeWrapperBuildDir)/$(Configuration)/*.dll" Condition="Exists('$(NativeWrapperBuildDir)/$(Configuration)/freerdp_wrapper.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(NativePublishLib)"
              DestinationFolder="$(PublishDir)"
              ContinueOnError="false" />
    </Target>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.999-cibuild0066948-alpha"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.999-cibuild0066948-alpha"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.999-cibuild0066948-alpha"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.999-cibuild0066948-alpha"/>
        <PackageReference Include="Avalonia.Wayland" Version="12.1.999-cibuild0066948-alpha"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    </ItemGroup>
</Project>
