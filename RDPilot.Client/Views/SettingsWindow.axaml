<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDPilot.Client.ViewModels"
        xmlns:views="using:RDPilot.Client.Views"
        x:Class="RDPilot.Client.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="600"
        Height="700"
        MinWidth="520"
        MinHeight="520"
        Title="Settings">
    <Grid Background="{DynamicResource RpChromeBrush}" RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="28,24,28,8" Spacing="4">
            <TextBlock Classes="PageTitle" Text="Settings"/>
            <TextBlock Classes="Muted" Text="Defaults for every connection. A connection can override them in its own settings." TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,16,28,28" Spacing="24">
                <views:QualitySettingsView DataContext="{Binding QualityEditor}"/>
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionTitle" Text="Updates"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="20">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Updates.CurrentVersionText}"/>
                            <TextBlock Classes="Caption" Text="{Binding Updates.CheckResult}" TextWrapping="Wrap"
                                       IsVisible="{Binding Updates.CheckResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Compact" VerticalAlignment="Center" Content="Check now"
                                Command="{Binding Updates.CheckNowCommand}" IsVisible="{Binding Updates.IsSupported}"/>
                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Check for updates automatically"
                                  IsChecked="{Binding CheckForUpdatesAutomatically}" IsVisible="{Binding Updates.IsSupported}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource RpCanvasBrush}" BorderBrush="{DynamicResource RpLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" MinWidth="96" Classes="Compact" IsCancel="True" Click="OnCancelClicked"/>
                <Button Content="Save" MinWidth="96" Classes="accent Compact" IsDefault="True" Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
