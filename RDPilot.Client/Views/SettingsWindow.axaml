<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDPilot.Client.ViewModels"
        xmlns:views="using:RDPilot.Client.Views"
        x:Class="RDPilot.Client.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="600"
        Height="700"
        MinWidth="520"
        MinHeight="520"
        Title="Settings">
    <Grid Background="{DynamicResource RpChromeBrush}" RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="28,24,28,8" Spacing="4">
            <TextBlock Classes="PageTitle" Text="Settings"/>
            <TextBlock Classes="Muted" Text="Defaults for every connection. A connection can override them in its own settings." TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <views:QualitySettingsView DataContext="{Binding QualityEditor}" Margin="28,16,28,28"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource RpCanvasBrush}" BorderBrush="{DynamicResource RpLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" MinWidth="96" Classes="Compact" IsCancel="True" Click="OnCancelClicked"/>
                <Button Content="Save" MinWidth="96" Classes="accent Compact" IsDefault="True" Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
