<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:vm="using:RDPilot.Client.ViewModels"
             xmlns:views="using:RDPilot.Client.Views"
             x:Class="RDPilot.Client.Views.ConnectionsPanelView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,*" Margin="14,14,10,10" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBlock Classes="SectionTitle" Text="Connections" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="FullscreenToolbarButton"
                    ToolTip.Tip="Add connection" AutomationProperties.Name="Add connection"
                    Click="OnAddConnectionClicked">
                <icons:FluentIcon Icon="Add" IconSize="Size16" FontSize="16"/>
            </Button>
            <Button Grid.Column="2" Classes="FullscreenToolbarButton"
                    ToolTip.Tip="Close" AutomationProperties.Name="Close connections"
                    Command="{Binding CloseConnectionsPanelCommand}">
                <icons:FluentIcon Icon="Dismiss" IconSize="Size16" FontSize="16"/>
            </Button>
        </Grid>
        <views:ConnectionListView Grid.Row="1"/>
    </Grid>
</UserControl>
