<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDPilot.Client.ViewModels"
        xmlns:views="using:RDPilot.Client.Views"
        x:Class="RDPilot.Client.Views.ConnectionEditorWindow"
        x:DataType="vm:ConnectionEditorViewModel"
        Width="600"
        Height="720"
        MinWidth="520"
        MinHeight="520"
        Title="{Binding Title}">
    <Grid Background="{DynamicResource RpChromeBrush}" RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="PageTitle" Text="{Binding Title}" Margin="28,24,28,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="28" Margin="28,12,28,28">
                <StackPanel Spacing="14">
                    <TextBlock Classes="SectionTitle" Text="Computer"/>
                    <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Name"/>
                                <TextBox Text="{Binding Name}" AutomationProperties.Name="Name"/>
                            </StackPanel>
                    <Grid ColumnDefinitions="*,110" ColumnSpacing="12">
                        <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Host name or IP address"/>
                                <TextBox Text="{Binding Host}" AutomationProperties.Name="Host name or IP address"/>
                            </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="FieldLabel" Text="Port"/>
                            <TextBox Text="{Binding Port}" AutomationProperties.Name="Port"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="14">
                    <TextBlock Classes="SectionTitle" Text="Sign in"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="User name (optional)"/>
                                <TextBox Text="{Binding Username}" AutomationProperties.Name="User name"/>
                            </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="FieldLabel" Text="Domain (optional)"/>
                            <TextBox Text="{Binding Domain}" AutomationProperties.Name="Domain"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Password"/>
                                <TextBox Text="{Binding Password}" PlaceholderText="{Binding PasswordWatermark}" PasswordChar="•" RevealPassword="False" AutomationProperties.Name="Password"/>
                            </StackPanel>
                </StackPanel>

                <Expander Classes="FormSection" IsExpanded="{Binding HasGateway, Mode=OneTime}">
                    <Expander.Header>
                        <StackPanel Spacing="2" Margin="0,6">
                            <TextBlock Classes="SectionTitle" Text="Remote Desktop Gateway"/>
                            <TextBlock Classes="Caption" Text="Only needed when the computer is reached through a gateway." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Margin="0,4">
                        <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Gateway host"/>
                                <TextBox Text="{Binding GatewayHost}" AutomationProperties.Name="Gateway host"/>
                            </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Gateway user name"/>
                                <TextBox Text="{Binding GatewayUsername}" AutomationProperties.Name="Gateway user name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="FieldLabel" Text="Gateway domain"/>
                                <TextBox Text="{Binding GatewayDomain}" AutomationProperties.Name="Gateway domain"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Gateway password"/>
                                <TextBox Text="{Binding GatewayPassword}" PlaceholderText="{Binding GatewayPasswordWatermark}" PasswordChar="•" AutomationProperties.Name="Gateway password"/>
                            </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="FormSection" IsExpanded="{Binding HasQualityOverrides, Mode=OneTime}">
                    <Expander.Header>
                        <StackPanel Spacing="2" Margin="0,6">
                            <TextBlock Classes="SectionTitle" Text="Display and performance"/>
                            <TextBlock Classes="Caption" Text="Override the defaults from Settings for this connection only." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander.Header>
                    <views:QualitySettingsView DataContext="{Binding QualityEditor}" Margin="0,4"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource RpCanvasBrush}" BorderBrush="{DynamicResource RpLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource RpWarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Cancel" MinWidth="96" Classes="Compact" IsCancel="True" Click="OnCancelClicked"/>
                <Button Grid.Column="2" Content="Save" MinWidth="96" Classes="accent Compact" IsDefault="True" Click="OnSaveClicked"/>
            </Grid>
        </Border>
    </Grid>
</Window>
