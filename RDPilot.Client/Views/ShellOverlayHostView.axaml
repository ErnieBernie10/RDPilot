<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RDPilot.Client.Views.ShellOverlayHostView"
             x:Name="Root">
    <Border Classes="OverlayPanel"
            Width="{Binding OverlayWidth, ElementName=Root}"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            IsVisible="{Binding IsOpen, ElementName=Root}">
        <ContentPresenter Content="{Binding OverlayContent, ElementName=Root}"/>
    </Border>
</UserControl>
