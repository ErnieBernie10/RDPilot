<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:vm="using:RDPilot.Client.ViewModels"
             xmlns:views="using:RDPilot.Client.Views"
             x:Class="RDPilot.Client.Views.NavigationRailView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="NavigationRail">
        <DockPanel Margin="6,8">
            <Button DockPanel.Dock="Bottom"
                    Classes="RailButton"
                    ToolTip.Tip="Settings"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsClicked">
                <icons:FluentIcon Icon="Settings" IconSize="Size20" FontSize="20"/>
            </Button>
            <Button DockPanel.Dock="Bottom"
                    Classes="RailButton"
                    Margin="0,0,0,6"
                    IsVisible="{Binding Updates.IsNoticeVisible}"
                    ToolTip.Tip="{Binding Updates.NoticeText}"
                    AutomationProperties.Name="Update available">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedBottom">
                        <views:UpdatePanelView DataContext="{Binding Updates}"/>
                    </Flyout>
                </Button.Flyout>
                <Panel>
                    <icons:FluentIcon Icon="ArrowDownload" IconSize="Size20" FontSize="20"/>
                    <Ellipse Width="8" Height="8" Margin="0,-3,-3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource RpAccentBrush}"/>
                </Panel>
            </Button>
            <StackPanel Spacing="6">
                <Button Classes="RailButton"
                        Classes.Active="{Binding IsConnectionsViewActive}"
                        ToolTip.Tip="Connections"
                        AutomationProperties.Name="Connections"
                        Command="{Binding ToggleConnectionsPanelCommand}">
                    <icons:FluentIcon Icon="Desktop" IconSize="Size20" FontSize="20"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
