<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:vm="using:RDPilot.Client.ViewModels"
             x:Class="RDPilot.Client.Views.RdpViewportView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="ViewportCard">
        <!-- The remote resolution is measured from this Grid rather than from the ScrollViewer
             below it. The ScrollViewer is collapsed until a session is live, so measuring it would
             report 0x0 right up until the moment we connect - too late, because the remote DPI is
             locked at connect time. The ScrollViewer stretches to fill this Grid, so the two report
             the same size once the session is up. -->
        <Grid Name="ViewportHost" SizeChanged="OnRdpViewportSizeChanged">
            <ScrollViewer Name="RdpScrollViewer"
                          Background="#0F1115"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsViewportLive}">
                <!-- Cursor is driven by the remote session: FreeRDP never draws the pointer into
                     the desktop framebuffer, so the shape arrives out-of-band. Null falls back to
                     the inherited cursor. -->
                <Image Source="{Binding SelectedSession.Screen}" Stretch="Fill"
                       Width="{Binding SelectedSession.DisplayWidth}"
                       Height="{Binding SelectedSession.DisplayHeight}"
                       Cursor="{Binding SelectedSession.RemoteCursor}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       PointerMoved="OnPointerMoved"
                       PointerPressed="OnPointerPressed"
                       PointerReleased="OnPointerReleased"
                       PointerWheelChanged="OnPointerWheelChanged"
                       Focusable="True"
                       Name="RdpImage"/>
            </ScrollViewer>

            <Border Classes="Card"
                    Width="360"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsViewportSplashVisible}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <icons:FluentIcon Icon="Desktop"
                                      IconSize="Size32"
                                      FontSize="40"
                                      HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewportHeading}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding ViewportDetail}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.75"/>
                    <Button Classes="Accent"
                            Command="{Binding ReconnectSessionCommand}"
                            CommandParameter="{Binding SelectedSession}"
                            IsVisible="{Binding CanShowReconnectAction}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:FluentIcon Icon="ArrowClockwise" IconSize="Size16" FontSize="16"/>
                            <TextBlock Text="Reconnect"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Accent"
                            Command="{Binding ConnectCommand}"
                            IsVisible="{Binding CanShowConnectAction}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:FluentIcon Icon="Play" IconSize="Size16" FontSize="16"/>
                            <TextBlock Text="Connect"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleConnectionsPanelCommand}"
                            IsVisible="{Binding CanShowConnectionsAction}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Open connections"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
