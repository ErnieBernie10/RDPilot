<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             xmlns:vm="using:RDPilot.Client.ViewModels"
             x:Class="RDPilot.Client.Views.RdpViewportView"
             xmlns:views="using:RDPilot.Client.Views"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.Failed">
            <Setter Property="Foreground" Value="{DynamicResource RpWarningBrush}"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="ViewportCard">
        <!-- The remote resolution is measured from this Grid rather than from the ScrollViewer
             below it. The ScrollViewer is collapsed until a session is live, so measuring it would
             report 0x0 right up until the moment we connect - too late, because the remote DPI is
             locked at connect time. The ScrollViewer stretches to fill this Grid, so the two report
             the same size once the session is up. -->
        <Grid Name="ViewportHost" SizeChanged="OnRdpViewportSizeChanged">
            <ScrollViewer Name="RdpScrollViewer"
                          Background="{DynamicResource RpCanvasBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsViewportLive}">
                <!-- Cursor is driven by the remote session: FreeRDP never draws the pointer into
                     the desktop framebuffer, so the shape arrives out-of-band. Null falls back to
                     the inherited cursor. -->
                <Image Source="{Binding SelectedSession.Screen}" Stretch="Fill"
                       Width="{Binding SelectedSession.DisplayWidth}"
                       Height="{Binding SelectedSession.DisplayHeight}"
                       Cursor="{Binding SelectedSession.RemoteCursor}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       PointerMoved="OnPointerMoved"
                       PointerPressed="OnPointerPressed"
                       PointerReleased="OnPointerReleased"
                       PointerWheelChanged="OnPointerWheelChanged"
                       Focusable="True"
                       Name="RdpImage"/>
            </ScrollViewer>

            <Grid IsVisible="{Binding IsLauncherVisible}"
                  MaxWidth="680"
                  Margin="32,56,32,24"
                  RowDefinitions="Auto,*"
                  RowSpacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                        <TextBlock Classes="PageTitle" FontSize="26" Text="Connect to a computer"/>
                        <TextBlock Classes="Muted" Text="Double-click a connection, or filter and press Enter." IsVisible="{Binding HasConnections}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="Compact" VerticalAlignment="Bottom" Click="OnAddConnectionClicked"
                            IsVisible="{Binding HasConnections}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:FluentIcon Icon="Add" IconSize="Size16" FontSize="16"/>
                            <TextBlock Text="Add connection"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <views:ConnectionListView Grid.Row="1"/>
            </Grid>

            <StackPanel IsVisible="{Binding IsSessionNoticeVisible}"
                        MaxWidth="440"
                        Margin="24"
                        Spacing="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Classes="Mark"
                        Width="56" Height="56" CornerRadius="14"
                        HorizontalAlignment="Center"
                        Background="{Binding SelectedSession.Connection.Id, Converter={x:Static views:ConnectionMarks.Brush}, FallbackValue={x:Null}}">
                    <TextBlock FontSize="20" Text="{Binding SelectedSession.Title, Converter={x:Static views:ConnectionMarks.Monogram}, FallbackValue=''}"/>
                </Border>
                <TextBlock Text="{Binding ViewportHeading}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Width="180"
                             MinHeight="3"
                             HorizontalAlignment="Center"
                             IsVisible="{Binding IsSelectedSessionConnecting}"/>
                <TextBlock Text="{Binding ViewportDetail}"
                           Classes="Muted"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Classes.Failed="{Binding IsSelectedSessionFailed}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0"
                            IsVisible="{Binding CanShowReconnectAction}">
                    <Button Classes="accent Compact"
                            Command="{Binding ReconnectSessionCommand}"
                            CommandParameter="{Binding SelectedSession}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:FluentIcon Icon="ArrowClockwise" IconSize="Size16" FontSize="16"/>
                            <TextBlock Text="Reconnect"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Compact"
                            Content="Close tab"
                            Command="{Binding CloseSessionCommand}"
                            CommandParameter="{Binding SelectedSession}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
