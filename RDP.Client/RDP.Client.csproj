<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NativeWrapperProjectDir>$(MSBuildProjectDirectory)/../RDP.Wrapper</NativeWrapperProjectDir>
        <NativeWrapperBuildDir>$(NativeWrapperProjectDir)/build</NativeWrapperBuildDir>
        <NativeWrapperCMakeArgs></NativeWrapperCMakeArgs>
        <NativeWrapperMsys2Root Condition="'$(NativeWrapperMsys2Root)' == ''">C:/msys64</NativeWrapperMsys2Root>
        <NativeWrapperMsys2UcrtBin>$(NativeWrapperMsys2Root)/ucrt64/bin</NativeWrapperMsys2UcrtBin>
        <NativeWrapperUseMsys2 Condition="'$(NativeWrapperUseMsys2)' == '' and Exists('$(NativeWrapperMsys2UcrtBin)/cmake.exe')">true</NativeWrapperUseMsys2>
        <NativeWrapperCMakeExe Condition="'$(NativeWrapperCMakeExe)' == '' and '$(NativeWrapperUseMsys2)' == 'true'">$(NativeWrapperMsys2UcrtBin)/cmake.exe</NativeWrapperCMakeExe>
        <NativeWrapperCMakeExe Condition="'$(NativeWrapperCMakeExe)' == ''">cmake</NativeWrapperCMakeExe>
        <NativeWrapperMsys2CMakeArgs Condition="Exists('$(NativeWrapperMsys2UcrtBin)/cc.exe') and Exists('$(NativeWrapperMsys2UcrtBin)/ninja.exe') and Exists('$(NativeWrapperMsys2UcrtBin)/pkg-config.exe')">-G Ninja -DCMAKE_C_COMPILER=$(NativeWrapperMsys2UcrtBin)/cc.exe -DCMAKE_MAKE_PROGRAM=$(NativeWrapperMsys2UcrtBin)/ninja.exe -DPKG_CONFIG_EXECUTABLE=$(NativeWrapperMsys2UcrtBin)/pkg-config.exe</NativeWrapperMsys2CMakeArgs>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
        <None Include="connection.local.json" Condition="Exists('connection.local.json')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>RDP.Client.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <Target Name="BuildNativeWrapper" BeforeTargets="BeforeBuild">
        <Message Importance="High" Text="Building Native Wrapper..." />
        <MakeDir Directories="$(NativeWrapperBuildDir)" />
        <Exec Condition="'$(NativeWrapperUseMsys2)' == 'true'" Command="cmd /c &quot;set &quot;PATH=$(NativeWrapperMsys2UcrtBin);$(NativeWrapperMsys2Root)/usr/bin;%PATH%&quot; &amp;&amp; &quot;$(NativeWrapperCMakeExe)&quot; -S &quot;$(NativeWrapperProjectDir)&quot; -B &quot;$(NativeWrapperBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration) $(NativeWrapperMsys2CMakeArgs) $(NativeWrapperCMakeArgs)&quot;" />
        <Exec Condition="'$(NativeWrapperUseMsys2)' == 'true'" Command="cmd /c &quot;set &quot;PATH=$(NativeWrapperMsys2UcrtBin);$(NativeWrapperMsys2Root)/usr/bin;%PATH%&quot; &amp;&amp; &quot;$(NativeWrapperCMakeExe)&quot; --build &quot;$(NativeWrapperBuildDir)&quot; --config $(Configuration)&quot;" />
        <Exec Condition="'$(NativeWrapperUseMsys2)' != 'true'" Command="&quot;$(NativeWrapperCMakeExe)&quot; -S &quot;$(NativeWrapperProjectDir)&quot; -B &quot;$(NativeWrapperBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration) $(NativeWrapperCMakeArgs)" />
        <Exec Condition="'$(NativeWrapperUseMsys2)' != 'true'" Command="&quot;$(NativeWrapperCMakeExe)&quot; --build &quot;$(NativeWrapperBuildDir)&quot; --config $(Configuration)" />

        <ItemGroup>
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.so" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.so')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dylib')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/libfreerdp_wrapper.dll')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/freerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/freerdp_wrapper.dll')" />
            <NativeLib Include="$(NativeWrapperBuildDir)/$(Configuration)/freerdp_wrapper.dll" Condition="Exists('$(NativeWrapperBuildDir)/$(Configuration)/freerdp_wrapper.dll')" />
        </ItemGroup>
        <Error Condition="'@(NativeLib)' == ''" Text="Native wrapper build succeeded, but no freerdp_wrapper native library was found in $(NativeWrapperBuildDir)." />
        <Copy SourceFiles="@(NativeLib)"
              DestinationFolder="$(OutputPath)"
              ContinueOnError="false" />
    </Target>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1"/>
    </ItemGroup>
</Project>
