<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDP.Client.ViewModels"
        xmlns:model="using:RDP.Client.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="RDP.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Title="RDP Client">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}" RowDefinitions="*,Auto">
        <Grid x:Name="ShellGrid" ColumnDefinitions="32,*">
            <Border Grid.Column="0" Classes="NavigationRail">
                <StackPanel Margin="4" Spacing="4">
                    <Button x:Name="ConnectionsPanelButton"
                            Content="C"
                            Classes="RailButton"
                            ToolTip.Tip="Saved connections"
                            Click="OnToggleConnectionsPanelClicked"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid RowDefinitions="Auto,*" Margin="2" RowSpacing="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TabControl ItemsSource="{Binding Sessions}"
                                    Classes="SessionTabs"
                                    SelectedItem="{Binding SelectedSession}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RdpSessionViewModel">
                                    <Grid MinWidth="160" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Opacity="0.65" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <Button Grid.Column="2"
                                                Content="x"
                                                Classes="TabCloseButton"
                                                Tag="{Binding}"
                                                ToolTip.Tip="Close tab"
                                                VerticalAlignment="Bottom"
                                                Click="OnTabCloseClicked"/>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Border Height="0" IsVisible="False"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Disconnect" Classes="TopBarButton" MinWidth="84" Command="{Binding DisconnectCommand}" IsVisible="{Binding SelectedSessionCanDisconnect}"/>
                            <Button Content="Reconnect" Classes="TopBarButton" MinWidth="84" Command="{Binding ReconnectSelectedSessionCommand}" IsVisible="{Binding SelectedSessionCanReconnect}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Classes="ViewportCard">
                        <ScrollViewer Name="RdpScrollViewer"
                                      Background="#0F1115"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="OnRdpViewportSizeChanged">
                            <Image Source="{Binding SelectedSession.Screen}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   PointerMoved="OnPointerMoved"
                                   PointerPressed="OnPointerPressed"
                                   PointerReleased="OnPointerReleased"
                                   PointerWheelChanged="OnPointerWheelChanged"
                                   Focusable="True"
                                   Name="RdpImage"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border x:Name="ConnectionsPanel"
                        Classes="OverlayPanel"
                        Width="280"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        IsVisible="False"
                        ZIndex="10">
                    <Grid RowDefinitions="Auto,*">
                        <Border Classes="ShellBar" Padding="8">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Grid ColumnDefinitions="*">
                                    <TextBlock Text="Connections" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Button Content="Connect" Classes="Accent Compact" Command="{Binding ConnectCommand}" Click="OnConnectSavedConnectionClicked"/>
                                    <Button Grid.Column="1" Content="Add" Classes="Compact" Click="OnAddConnectionClicked"/>
                                    <Button Grid.Column="2" Content="Edit" Classes="Compact" Click="OnEditConnectionClicked"/>
                                    <Button Grid.Column="3" Content="Delete" Classes="Compact" Click="OnDeleteConnectionClicked"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" Background="Transparent" BorderThickness="0" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="model:SavedConnection">
                                    <Border Padding="8,7" CornerRadius="4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Host}" FontSize="12" Opacity="0.72"/>
                                            <TextBlock Text="{Binding Username}" FontSize="12" Opacity="0.56"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8,4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
